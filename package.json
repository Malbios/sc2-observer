{
  "name": "sc2-observer",
  "version": "0.0.0",
  "private": true,
  "description": "Spectator: headless SC2 container, bot-facing proxy, and per-game recording",
  "main": "out/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json",
    "record": "node dist/cli/record.js",
    "dump": "node dist/cli/dump.js",
    "testbot": "node dist/cli/testbot.js",
    "import-telemetry": "node dist/cli/import-telemetry.js",
    "probe-endgame": "node dist/cli/probe-endgame.js",
    "session": "node dist/cli/session.js",
    "verify": "npm run build && node dist/cli/verify-extraction.js && node dist/cli/verify-telemetry.js && node dist/cli/verify-tailer.js && node dist/cli/verify-docker.js && node dist/cli/verify-proxy.js && node dist/cli/verify-session.js",
    "spike": "node spike/proxy.js",
    "dev": "electron-vite dev",
    "build:app": "electron-vite build"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "protobufjs": "^7.4.0",
    "uplot": "^1.6.32",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "pixi.js": "^8.21.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
